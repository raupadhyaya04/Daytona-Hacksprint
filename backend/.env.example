# ── Copy this file to `.env` and fill in your keys. `.env` is gitignored. ──

# Tensorix (OpenAI-compatible inference). Key label at hackathon: "Daytona-Hacksprint".
# Paste the sk-... value Tensorix showed you when you created the key.
TENSORIX_API_KEY=sk-...
TENSORIX_BASE_URL=https://api.tensorx.ai/v1

# Daytona sandboxes
DAYTONA_API_KEY=

# Models (all Tensorix model IDs; must support tool/function calling for the defender)
ATTACKER_MODEL=z-ai/glm-5.2
DEFENDER_MODEL=z-ai/glm-5.2
JUDGE_MODEL=z-ai/glm-5.2

# Run mode: set MOCK=1 to run with a scripted attacker/defender and a fake sandbox.
# No Tensorix or Daytona keys needed in mock mode. Great for frontend dev + demo fallback.
MOCK=0

# Loop guardrails
MAX_TURNS=8
MAX_TOOL_CALLS_PER_TURN=4
RUN_TIMEOUT_SEC=300
SANDBOX_EXEC_TIMEOUT=30

# Concurrency + benchmarking
MAX_CONCURRENT_RUNS=2     # runs holding Daytona sandboxes at once (single runs + batch cells)
HEARTBEAT_SEC=15         # SSE keepalive ping interval during long provisioning
BATCH_MAX_RUNS=24        # safety cap on runs a single /api/batch can spawn

# Provision a second (attacker) sandbox so both agents are genuinely isolated.
USE_ATTACKER_SANDBOX=1

# Where run logs (JSONL) are written
DATA_DIR=./data

# CORS origins for the frontend (comma-separated, or * for any)
CORS_ORIGINS=*
